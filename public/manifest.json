{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "packageName": "com.contoso.scantocutsheets",
  "developer": {
    "name": "Contoso",
    "websiteUrl": "https://contoso.com",
    "privacyUrl": "https://contoso.com/privacy",
    "termsOfUseUrl": "https://contoso.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Scan to Cut Sheets",
    "full": "Barcode Scanner to SharePoint Cut Sheets"
  },
  "description": {
    "short": "Scan asset tags and create cut sheets",
    "full": "Scan asset tag barcodes from computer boxes using your camera and batch-create cut sheet records in SharePoint."
  },
  "accentColor": "#0078D4",
  "configurableTabs": [],
  "staticTabs": [
    {
      "entityId": "scanner",
      "name": "Scanner",
      "contentUrl": "https://{{HOSTNAME}}/index.html",
      "websiteUrl": "https://{{HOSTNAME}}/index.html",
      "scopes": ["personal"]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["{{HOSTNAME}}"],
  "webApplicationInfo": {
    "id": "{{AZURE_CLIENT_ID}}",
    "resource": "api://{{HOSTNAME}}/{{AZURE_CLIENT_ID}}"
  },
  "devicePermissions": ["media"]
}
