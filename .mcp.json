      "command": "node",
      "args": ["/Volumes/bingobango/code/scanToCutsheets/mcp-servers/android-emulator/index.js"],
      "env": {
        "ANDROID_SDK_ROOT": "/Volumes/bingobango/android-sdk",
        "ADB_PATH": "/Volumes/bingobango/android-sdk/platform-tools/adb",
        "EMULATOR_PATH": "/Volumes/bingobango/android-sdk/emulator/emulator",
        "DEFAULT_AVD": "Pixel_7_API_34",
        "SCREENSHOT_DIR": "/tmp/android-screenshots"
      }
    },
    "activity-monitor": {
      "command": "node",
      "args": ["/Volumes/bingobango/code/scanToCutsheets/mcp-servers/activity-monitor/index.js"]
    },
    "powerplatform-debug": {
      "command": "node",
      "args": ["/Volumes/bingobango/code/scanToCutsheets/mcp-servers/powerplatform-debug/index.js"],
      "env": {
        "DOTNET_ROOT": "/opt/homebrew/Cellar/dotnet/10.0.105/libexec",
        "PAC_PATH": "/Users/johnadkerson/.dotnet/tools/pac",
        "APP_DEBUG_DIR": "/Volumes/bingobango/code/scanToCutsheets/app-debug",
        "SHAREPOINT_SITE": "https://encoretch.sharepoint.com/sites/CCHMCRefreshSupport"
      }
    }
  }
