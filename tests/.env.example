# Power Apps Barcode Scanner - Test Environment Configuration
# Copy this file to .env and fill in actual values

# =============================================================================
# POWER APPS CONFIGURATION
# =============================================================================

# Power Apps application URL
# Get this from Power Apps Studio: File > Details > App ID
# Format: https://apps.powerapps.com/play/e/{environment-id}/a/{app-id}
POWER_APPS_URL=https://apps.powerapps.com/play/e/YOUR-ENVIRONMENT/a/YOUR-APP-ID

# =============================================================================
# SHAREPOINT CONFIGURATION
# =============================================================================

# SharePoint site URL
SHAREPOINT_URL=https://your-tenant.sharepoint.com/sites/AssetTracking

# SharePoint list URL (for data verification)
SHAREPOINT_LIST_URL=https://your-tenant.sharepoint.com/sites/AssetTracking/Lists/ComputerAssetScans

# =============================================================================
# TEST USER CREDENTIALS
# =============================================================================

# Primary test user (should have Contribute permissions on SharePoint list)
TEST_USER_EMAIL=test.user@your-tenant.onmicrosoft.com
TEST_USER_PASSWORD=your-test-user-password

# Admin test user (optional, for permission-related tests)
# ADMIN_USER_EMAIL=admin@your-tenant.onmicrosoft.com
# ADMIN_USER_PASSWORD=your-admin-password

# =============================================================================
# TEST CONFIGURATION
# =============================================================================

# Run tests in CI mode (affects timeouts and retries)
CI=false

# Enable debug logging
DEBUG=false

# Browser to use for E2E tests (chromium, firefox, webkit)
BROWSER=chromium

# Run tests in headless mode (set to false for visual debugging)
HEADLESS=false
