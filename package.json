{
  "name": "encore-power-app",
  "version": "1.0.0",
  "description": "Power Apps Barcode Scanner for Computer Asset Tracking",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --config tests/jest.config.js",
    "test:unit:watch": "jest --config tests/jest.config.js --watch",
    "test:unit:coverage": "jest --config tests/jest.config.js --coverage",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:headed": "playwright test --config tests/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config tests/playwright.config.ts --debug",
    "test:e2e:ui": "playwright test --config tests/playwright.config.ts --ui",
    "playwright:install": "playwright install",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "clean": "rm -rf dist coverage test-results",
    "prepare": "npm run build"
  },
  "keywords": [
    "power-apps",
    "barcode-scanner",
    "sharepoint",
    "microsoft-365",
    "asset-tracking"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "playwright": "^1.41.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
