{
  "name": "scan-to-cutsheets",
  "version": "1.0.0",
  "description": "Microsoft Teams Tab App for scanning asset tag barcodes and creating SharePoint cut sheets",
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev-mobile.sh",
    "dev:web": "vite --host",
    "dev:ios": "vite --host & sleep 3 && open -a Simulator && sleep 2 && xcrun simctl openurl booted \"http://$(ipconfig getifaddr en0):5173\"",
    "dev:android": "vite --host & sleep 3 && ~/Library/Android/sdk/emulator/emulator -avd Pixel_3a_API_30_x86 & sleep 15 && ~/Library/Android/sdk/platform-tools/adb shell am start -a android.intent.action.VIEW -d 'http://10.0.2.2:5173'",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "package:teams": "./scripts/package-teams.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run src/types",
    "test:store": "vitest run src/store",
    "test:components": "vitest run src/components",
    "test:hooks": "vitest run src/hooks"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.30.0",
    "@azure/msal-react": "^2.2.0",
    "@ericblade/quagga2": "^1.8.0",
    "@fluentui/react-components": "^9.54.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@microsoft/teams-js": "^2.48.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "uuid": "^9.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
